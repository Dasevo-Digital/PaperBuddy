PAPERBUDDY_ADMIN_USER=admin
PAPERBUDDY_ADMIN_PASSWORD=bitte-aendern
PAPERBUDDY_OCR_LANGUAGE=deu+eng
SCANNER_PASSWORD=bitte-aendern
# Optional
# PAPERBUDDY_OFFICE=1                # LibreOffice für Office-Vorschau ins Image
# FTP_ADDRESS=192.168.1.10          # für docker compose --profile ftp up -d
# PAPERBUDDY_SCANNERS=Büro=http://192.168.1.20/eSCL
# PAPERBUDDY_URL=https://docs.example.org
# PAPERBUDDY_TRUSTED_PROXIES=172.18.0.1   # Reverse-Proxy, dessen X-Forwarded-For gilt
# PAPERBUDDY_BACKUP_DIR=/backup          # tägliche, verschlüsselte Sicherung nach ./backup
# PAPERBUDDY_BACKUP_PASSPHRASE=bitte-lange-passphrase-waehlen
