[Unit]
Description=PaperBuddy Dokumentenserver
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=paperbuddy
Group=paperbuddy
EnvironmentFile=/etc/paperbuddy/paperbuddy.env
WorkingDirectory=/var/lib/paperbuddy
ExecStart=/opt/paperbuddy/bin/server
Restart=on-failure
RestartSec=5

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
# Sicherungen (PAPERBUDDY_BACKUP_DIR) nach /var/backups/paperbuddy; dort lässt
# sich auch eine NAS-Freigabe einhängen.
ReadWritePaths=/var/lib/paperbuddy -/var/backups/paperbuddy

[Install]
WantedBy=multi-user.target
